# Backend: comma-separated origins allowed by CORS (only needed when the frontend is served from another origin).
CORS_ORIGINS=http://localhost:5173
# Frontend (build time): API base URL. Leave empty when the API is served from the same origin (Vercel, Docker, Vite proxy).
VITE_API_BASE=
# Frontend dev server: where Vite proxies /api.
API_PROXY_TARGET=http://localhost:8000
